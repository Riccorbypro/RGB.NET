<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/2010/manifest"
         xmlns:w10="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 mp">
    <Identity Name="RGB.NET.Devices.DynamicLighting"
              Version="1.0.0.0"
              Publisher="RGB.NET"/>
    <Properties>
        <DisplayName>RGB.NET Windows Dynamic Lighting Integration</DisplayName>
        <PublisherDisplayName>RGB.NET</PublisherDisplayName>
        <Logo>icon.png</Logo>
    </Properties>
    <Prerequisites>
        <OSMinVersion>10.0.26100.0</OSMinVersion>
        <OSMaxVersionTested>10.0.26100.0</OSMaxVersionTested>
    </Prerequisites>
    <Extensions>
        <uap3:Extension Category="windows.appExtension">
            <uap3:AppExtension Name="com.microsoft.windows.lighting" Id="Id" DisplayName="Id">
            </uap3:AppExtension>
        </uap3:Extension>
    </Extensions>
    <Capabilities>
        <rescap:Capability Name="runFullTrust"/>
    </Capabilities>
</Package>